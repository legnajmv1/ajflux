# Copia este archivo como .env y completa los valores reales (no se sube al repo).

# Clave secreta de Django. Genera una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# False en producción.
DJANGO_DEBUG=False

# Dominios/IPs permitidos, separados por comas. Ej: ajflux.tudominio.com,localhost,127.0.0.1,192.168.1.10
DJANGO_ALLOWED_HOSTS=

# Orígenes HTTPS de confianza para CSRF, separados por comas. Ej: https://ajflux.tudominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Orígenes permitidos para CORS, separados por comas. Vacío = ninguno (la app móvil no usa CORS).
DJANGO_CORS_ALLOWED_ORIGINS=

# Redes a escanear, separadas por comas (formato CIDR, ej: 192.168.1.0/24). Vacío = detección automática.
SCAN_NETWORKS=

# Token del túnel de Cloudflare (ver Bloque 3 / DESPLIEGUE.md).
TUNNEL_TOKEN=
